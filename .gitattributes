# 统一换行策略：文本文件入库与检出均用 LF，杜绝跨平台行尾抖动。
* text=auto eol=lf

# Windows 专用脚本保留 CRLF。
*.bat eol=crlf
*.cmd eol=crlf
*.ps1 eol=crlf

# 二进制资产：不做行尾转换与文本 diff。
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.zip binary
*.so binary
*.a binary
*.o binary
*.bin binary
*.img binary
*.apk binary
*.keystore binary
*.jks binary
